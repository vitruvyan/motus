{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitruvyan.com/motus/contract/regulatory-evidence-profile.v1.schema.json",
  "title": "Vitruvyan Motus Regulatory Evidence Profile, v1",
  "description": "ADR-038. A jurisdiction-neutral mapping from opaque external requirement references to existing Motus evidence kinds. Validity or evidence completeness is not a compliance, conformity, certification, safety, or legal-sufficiency verdict.",
  "type": "object",
  "required": ["schema_version", "profile", "requirements"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {"$ref": "#/$defs/ProfileIdentity"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/Requirement"}
    }
  },
  "$defs": {
    "BoundedToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "ProfileIdentity": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/BoundedToken"},
        "version": {"$ref": "#/$defs/BoundedToken"}
      }
    },
    "Requirement": {
      "type": "object",
      "required": ["requirement_ref", "evidence"],
      "additionalProperties": false,
      "properties": {
        "requirement_ref": {"$ref": "#/$defs/BoundedToken"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/EvidenceExpectation"}
        }
      }
    },
    "EvidenceExpectation": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "execution_receipt",
            "system_manifest",
            "risk_control_registry",
            "control_application",
            "human_oversight_receipt"
          ]
        }
      }
    }
  }
}