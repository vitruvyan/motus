{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitruvyan.com/motus/contract/ai-system-registration.v1.schema.json",
  "title": "Vitruvyan Motus AI System Registration, v1",
  "description": "ADR-041. One producer's immutable registration claim bound to one exact System Manifest. Validity is not legal registration, deployment or compliance.",
  "type": "object",
  "required": ["schema_version", "producer_namespace", "producer_ref", "registry_id", "registration_id", "system_id", "system_manifest_fingerprint", "declared_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "producer_namespace": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
    "producer_ref": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
    "registry_id": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
    "registration_id": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
    "system_id": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
    "system_manifest_fingerprint": {"$ref": "commitment.v1.schema.json#/$defs/Digest"},
    "purposes": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/Text"}},
    "contexts": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/Text"}},
    "parties": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/Party"}},
    "external_references": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/ExternalReference"}},
    "declared_at": {"$ref": "system-manifest.v1.schema.json#/$defs/UtcTimestamp"},
    "supersedes": {"$ref": "commitment.v1.schema.json#/$defs/Digest"}
  },
  "$defs": {
    "Text": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "Reference": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
    "Party": {
      "type": "object", "required": ["role", "party_ref"], "additionalProperties": false,
      "properties": {
        "role": {"enum": ["producer", "operator", "owner", "accountable_party", "technical_contact", "other"]},
        "party_ref": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
        "description": {"$ref": "#/$defs/Text"}
      }
    },
    "ExternalReference": {
      "type": "object", "required": ["kind", "reference"], "additionalProperties": false,
      "properties": {
        "kind": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
        "reference": {"$ref": "#/$defs/Reference"}
      }
    }
  }
}
