{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitruvyan.com/motus/contract/retention-application.v1.schema.json",
  "title": "Vitruvyan Motus RetentionApplication, v1",
  "description": "ADR-040. Immutable custodian action claim. Missing hold bindings say nothing about hold absence.",
  "type": "object",
  "required": ["schema_version", "producer_namespace", "producer_ref", "application_id", "policy_fingerprint", "artifacts", "operation", "outcome", "custodian_ref", "method_ref", "observed_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "producer_namespace": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
    "producer_ref": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
    "application_id": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
    "policy_fingerprint": {"$ref": "commitment.v1.schema.json#/$defs/Digest"},
    "hold_fingerprints": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "commitment.v1.schema.json#/$defs/Digest"}},
    "scope_snapshot_fingerprints": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "commitment.v1.schema.json#/$defs/Digest"}},
    "artifacts": {"$ref": "retention-policy-declaration.v1.schema.json#/$defs/ArtifactIdentities"},
    "operation": {"enum": ["preservation", "deletion", "migration", "restoration", "quarantine", "deletion_blocked"]},
    "outcome": {"enum": ["attempted", "completed", "failed", "blocked"]},
    "custodian_ref": {"$ref": "commitment.v1.schema.json#/$defs/Identifier"},
    "method_ref": {"$ref": "retention-policy-declaration.v1.schema.json#/$defs/Reference"},
    "observed_at": {"$ref": "system-manifest.v1.schema.json#/$defs/UtcTimestamp"},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "retention-policy-declaration.v1.schema.json#/$defs/ArtifactIdentity"}},
    "oversight_fingerprint": {"$ref": "commitment.v1.schema.json#/$defs/Digest"},
    "supersedes": {"$ref": "commitment.v1.schema.json#/$defs/Digest"}
  }
}
