{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitruvyan.com/motus/contract/system-manifest.v1.schema.json",
  "title": "Vitruvyan Motus System Manifest, v1",
  "description": "ADR-035. A versioned declaration of one AI system configuration. The manifest separates independently verifiable bindings from operator declarations. Schema validity is not binding verification, does not establish any ADR-020 trust level, and is never a compliance verdict.",
  "type": "object",
  "required": [
    "schema_version",
    "system",
    "bindings",
    "declarations",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "system": {
      "$ref": "#/$defs/SystemIdentity"
    },
    "bindings": {
      "$ref": "#/$defs/Bindings"
    },
    "declarations": {
      "$ref": "#/$defs/Declarations"
    },
    "created_at": {
      "$ref": "#/$defs/UtcTimestamp",
      "description": "When this manifest document was created. SM3 validates the calendar value; this is not deployment time, approval time, or legal time."
    },
    "supersedes": {
      "oneOf": [
        {
          "$ref": "commitment.v1.schema.json#/$defs/Digest"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional fingerprint of the manifest this document declares it supersedes. This is lineage asserted by the document, not proof that either revision was deployed or approved."
    }
  },
  "$defs": {
    "SystemIdentity": {
      "type": "object",
      "required": [
        "id",
        "manifest_version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier",
          "description": "Operator-assigned stable identity of the AI system across manifest revisions."
        },
        "manifest_version": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier",
          "description": "Operator-assigned revision label for this declared configuration. It is metadata, not the cryptographic identity of the document."
        },
        "name": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier",
          "description": "Optional human-readable system name."
        }
      }
    },
    "Bindings": {
      "type": "object",
      "required": [
        "motus",
        "graphs"
      ],
      "additionalProperties": false,
      "properties": {
        "motus": {
          "$ref": "#/$defs/MotusBinding"
        },
        "graphs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/GraphBinding"
          },
          "description": "Graph identities this manifest declares as part of the system configuration. Validation checks shape; a later binding verifier must recompute these values from authoritative GraphSpec/trace artifacts."
        }
      }
    },
    "MotusBinding": {
      "type": "object",
      "required": [
        "runtime_version",
        "trace_schema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime_version": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier",
          "description": "Motus runtime version this manifest declares for the system configuration. Schema validity does not prove that a deployment actually ran it."
        },
        "trace_schema_version": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier",
          "description": "Trace schema version this manifest declares for the system configuration. Binding verification is separate."
        }
      }
    },
    "GraphBinding": {
      "type": "object",
      "required": [
        "name",
        "version",
        "spec_schema_version",
        "graph_fingerprint",
        "code_fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "version": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "spec_schema_version": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "graph_fingerprint": {
          "type": "string",
          "pattern": "^graph:sha256:[0-9a-f]{64}$",
          "description": "The GraphSpec fingerprint this manifest declares. It is not trusted until independently recomputed from the supplied GraphSpec."
        },
        "code_fingerprint": {
          "type": "string",
          "pattern": "^code:sha256:[0-9a-f]{64}$",
          "description": "The runtime code fingerprint this manifest declares. It is not trusted until independently checked against execution/runtime evidence."
        }
      }
    },
    "Declarations": {
      "type": "object",
      "required": [
        "operator"
      ],
      "additionalProperties": false,
      "properties": {
        "operator": {
          "$ref": "#/$defs/Operator"
        },
        "components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "policies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Policy"
          }
        },
        "controls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Control"
          }
        }
      },
      "description": "Operator-supplied context. Validation proves only that these declarations are well formed. Their truth requires separate evidence or attestation."
    },
    "Operator": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "name": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        }
      }
    },
    "Component": {
      "type": "object",
      "required": [
        "component_id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "runtime",
            "graph",
            "model",
            "tool",
            "service",
            "data_source",
            "other"
          ],
          "description": "Closed v1 vocabulary. Product, provider, customer and jurisdiction names belong in values, never in the canonical type system."
        },
        "name": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "version": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "supplier": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "Policy": {
      "type": "object",
      "required": [
        "policy_id"
      ],
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "Control": {
      "type": "object",
      "required": [
        "control_id"
      ],
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier"
        },
        "policy_ref": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier",
          "description": "When present, SM2 requires this id to name a policy declared in the same manifest."
        },
        "enforcement_point": {
          "$ref": "commitment.v1.schema.json#/$defs/Identifier",
          "description": "Optional neutral name of where the operator declares the control is enforced. It is a declaration, not evidence the control ran."
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?Z$",
      "description": "RFC 3339 UTC Z-form timestamp shape. Fractional seconds may carry any positive number of digits and second 60 is admitted for leap-second instants. SM3 supplies calendar and leap-second validity."
    }
  }
}
